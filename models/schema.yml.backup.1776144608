version: 2

models:
  # ============================================================================
  # STAGING LAYER - Data Cleaning and Deduplication
  # ============================================================================

  - name: stg_customers
    description: >\n      Cleaned customer dimension. Deduplicates raw customer records, removes test data\n      (customer_type='samet'), and standardizes KYC status values.\n      Input: 441,409 rows → Output: ~34 rows
    columns:
      - name: customer_id
        description: Unique customer identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_type
        description: Type of customer (individual, business, etc.)
        data_type: STRING
      - name: email
        description: Customer email address
        data_type: STRING
      - name: phone_number
        description: Customer phone number
        data_type: STRING
      - name: kyc_status
        description: >\n          KYC verification status (standardized to VERIFIED, UNKNOWN, or other values).\n          Maps {ok, done, yes} → VERIFIED
        data_type: STRING
        tests:
          - accepted_values:
              values: ['VERIFIED', 'UNKNOWN', 'PENDING', 'REJECTED']
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_payment_methods
    description: >\n      Cleaned payment methods. Deduplicates raw records and consolidates payment method types.\n      Maps credit_card → card for consistency.\n      Input: 359,247 rows → Output: ~21 rows
    columns:
      - name: payment_method_id
        description: Unique payment method identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_id
        description: Customer who owns this payment method
        data_type: STRING
        tests:
          - not_null
      - name: method_type
        description: >\n          Type of payment method (card, bank_account, digital_wallet, etc.).\n          Consolidates credit_card → card
        data_type: STRING
      - name: is_default
        description: Whether this is the customer's default payment method
        data_type: BOOLEAN
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_transactions
    description: >\n      Cleaned transactions. Deduplicates raw records, validates status values,\n      and ensures debtor and creditor are different entities.\n      FIXED: Maps source column debtor_cus_id → debtor_customer_id for consistency.\n      Input: 359,262 rows → Output: ~21 rows
    columns:
      - name: transaction_id
        description: Unique transaction identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: debtor_customer_id
        description: Customer ID of the payer
        data_type: STRING
        tests:
          - not_null
      - name: creditor_customer_id
        description: Customer ID of the payee
        data_type: STRING
        tests:
          - not_null
      - name: payment_method_id
        description: Payment method used for this transaction
        data_type: STRING
      - name: amount
        description: Transaction amount (must be positive)
        data_type: NUMERIC
        tests:
          - not_null
          - dbt_expectations.expect_column_values_to_be_of_type:
              column_type: numeric
      - name: currency
        description: Currency code (e.g., USD, EUR)
        data_type: STRING
      - name: status
        description: Transaction status
        data_type: STRING
        tests:
          - accepted_values:
              values: ['pending', 'completed', 'failed', 'cancelled']
      - name: reference
        description: Transaction reference number
        data_type: STRING
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
        tests:
          - not_null
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_transaction_legs
    description: >\n      CRITICAL: Rebuilt transaction ledger structure. Fixes broken state where each transaction\n      had 17,108 ledger entries instead of the correct 2 entries (1 debit, 1 credit).\n      \n      Strategy: Groups by transaction_id and direction, aggregates amounts, and validates\n      double-entry accounting (sum of debits = sum of credits).\n      \n      Input: 359,268 rows (17,108 per transaction) → Output: ~42 rows (2 per transaction)
    columns:
      - name: transaction_id
        description: Unique transaction identifier
        data_type: STRING
        tests:
          - not_null
      - name: direction
        description: Ledger entry direction (debit or credit)
        data_type: STRING
        tests:
          - accepted_values:
              values: ['debit', 'credit']
      - name: amount
        description: Aggregated amount for this ledger entry
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: account
        description: Account identifier for this ledger entry
        data_type: STRING
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP

  - name: stg_refunds
    description: >\n      Cleaned refunds. Deduplicates raw records, validates foreign keys to transactions,\n      and removes invalid records.\n      Input: 205,308 rows → Output: ~12 rows
    columns:
      - name: refund_id
        description: Unique refund identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: original_transaction_id
        description: Transaction being refunded
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('stg_transactions')
              field: transaction_id
      - name: amount
        description: Refund amount
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: reason
        description: Reason for refund
        data_type: STRING
      - name: status
        description: Refund status
        data_type: STRING
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_disputes
    description: >\n      Cleaned disputes. Deduplicates raw records, removes test disputes (reason='Test Dispute'),\n      validates foreign keys to transactions.\n      Input: 205,318 rows → Output: ~12 rows
    columns:
      - name: dispute_id
        description: Unique dispute identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: transaction_id
        description: Transaction being disputed
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('stg_transactions')
              field: transaction_id
      - name: amount
        description: Dispute amount
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: reason
        description: Reason for dispute
        data_type: STRING
      - name: status
        description: Dispute status
        data_type: STRING
        tests:
          - accepted_values:
              values: ['open', 'resolved', 'lost', 'won']
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_fees
    description: >\n      Cleaned fees. Deduplicates raw records, removes test fees (fee_type='Test Fee'),\n      validates foreign keys to transactions.\n      Input: 359,289 rows → Output: ~21 rows
    columns:
      - name: fee_id
        description: Unique fee identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: transaction_id
        description: Transaction this fee is associated with
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('stg_transactions')
              field: transaction_id
      - name: amount
        description: Fee amount
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: fee_type
        description: Type of fee
        data_type: STRING
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP

  - name: stg_mandates
    description: >\n      Cleaned mandates. Deduplicates raw records, validates customer foreign keys.\n      Input: 342,180 rows → Output: ~20 rows
    columns:
      - name: mandate_id
        description: Unique mandate identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_id
        description: Customer this mandate belongs to
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('stg_customers')
              field: customer_id
      - name: payment_method_id
        description: Payment method for this mandate
        data_type: STRING
      - name: reference
        description: Mandate reference
        data_type: STRING
      - name: status
        description: Mandate status
        data_type: STRING
        tests:
          - accepted_values:
              values: ['active', 'inactive', 'cancelled']
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP

  - name: stg_payouts
    description: >\n      Cleaned payouts. Deduplicates raw records, validates recipient customer foreign keys.\n      Input: 359,301 rows → Output: ~21 rows
    columns:
      - name: payout_id
        description: Unique payout identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: recipient_customer_id
        description: Customer receiving the payout
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('stg_customers')
              field: customer_id
      - name: amount
        description: Payout amount
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: status
        description: Payout status
        data_type: STRING
        tests:
          - accepted_values:
              values: ['pending', 'completed', 'failed', 'cancelled']
      - name: scheduled_at
        description: When the payout was scheduled
        data_type: TIMESTAMP
      - name: executed_at
        description: When the payout was executed
        data_type: TIMESTAMP
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP

  # ============================================================================
  # FRAUD ANALYTICS STAGING MODELS
  # ============================================================================

  - name: stg_transactions_fraud
    description: >\n      Transactions enriched with fraud indicator from disputes. Joins stg_transactions\n      with stg_disputes to add is_fraud flag (1 if transaction has a dispute, 0 otherwise).\n      Used as the base for fraud analytics and ML feature engineering.
    columns:
      - name: transaction_id
        description: Unique transaction identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: debtor_customer_id
        description: Customer ID of the payer
        data_type: STRING
        tests:
          - not_null
      - name: creditor_customer_id
        description: Customer ID of the payee
        data_type: STRING
        tests:
          - not_null
      - name: payment_method_id
        description: Payment method used for this transaction
        data_type: STRING
      - name: amount
        description: Transaction amount
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: status
        description: Transaction status
        data_type: STRING
      - name: reference
        description: Transaction reference number
        data_type: STRING
      - name: is_fraud
        description: Fraud indicator (1 if transaction has a dispute, 0 otherwise)
        data_type: INTEGER
        tests:
          - not_null
          - accepted_values:
              values: [0, 1]
      - name: dispute_id
        description: Associated dispute ID (null if no dispute)
        data_type: STRING
      - name: dispute_amount
        description: Dispute amount (null if no dispute)
        data_type: NUMERIC
      - name: dispute_reason
        description: Reason for dispute (null if no dispute)
        data_type: STRING
      - name: dispute_status
        description: Dispute status (null if no dispute)
        data_type: STRING
      - name: created_at
        description: Transaction creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Transaction last update timestamp
        data_type: TIMESTAMP

  - name: stg_customer_transaction_history
    description: >\n      Customer transaction history aggregates for ML feature engineering.\n      Computes transaction counts, totals, averages, and temporal features per customer.\n      One row per unique customer_id from debtor_customer_id in stg_transactions_fraud.
    columns:
      - name: customer_id
        description: Unique customer identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: total_transactions
        description: Total number of transactions by this customer
        data_type: INTEGER
        tests:
          - not_null
      - name: fraud_transactions
        description: Number of fraudulent transactions (with disputes)
        data_type: INTEGER
      - name: legitimate_transactions
        description: Number of legitimate transactions (no disputes)
        data_type: INTEGER
      - name: total_amount
        description: Total transaction amount across all transactions
        data_type: NUMERIC
      - name: avg_amount
        description: Average transaction amount
        data_type: NUMERIC
      - name: min_amount
        description: Minimum transaction amount
        data_type: NUMERIC
      - name: max_amount
        description: Maximum transaction amount
        data_type: NUMERIC
      - name: stddev_amount
        description: Standard deviation of transaction amounts
        data_type: NUMERIC
      - name: completed_transactions
        description: Number of completed transactions
        data_type: INTEGER
      - name: failed_transactions
        description: Number of failed transactions
        data_type: INTEGER
      - name: pending_transactions
        description: Number of pending transactions
        data_type: INTEGER
      - name: first_transaction_date
        description: Date of first transaction
        data_type: TIMESTAMP
      - name: last_transaction_date
        description: Date of most recent transaction
        data_type: TIMESTAMP
      - name: days_active
        description: Number of days between first and last transaction
        data_type: INTEGER
      - name: fraud_rate_pct
        description: Percentage of transactions that are fraudulent (0-100)
        data_type: NUMERIC
      - name: dbt_created_at
        description: When this record was created by dbt
        data_type: TIMESTAMP

  - name: stg_fraud_features
    description: >\n      ML-ready fraud features derived from transactions, customer history, and payment methods.\n      Includes behavioral, temporal, and monetary features for fraud detection models.\n      One row per transaction with comprehensive feature set.
    columns:
      - name: transaction_id
        description: Unique transaction identifier
        data_type: STRING
        tests:
          - not_null
      - name: debtor_customer_id
        description: Customer ID of the payer
        data_type: STRING
        tests:
          - not_null
      - name: creditor_customer_id
        description: Customer ID of the payee
        data_type: STRING
        tests:
          - not_null
      - name: payment_method_id
        description: Payment method used
        data_type: STRING
      - name: fraud_label
        description: Target variable for ML (1=fraud, 0=legitimate)
        data_type: INTEGER
        tests:
          - not_null
          - accepted_values:
              values: [0, 1]
      - name: transaction_amount
        description: Transaction amount in original currency
        data_type: NUMERIC
        tests:
          - not_null
      - name: currency
        description: Currency code
        data_type: STRING
      - name: transaction_status
        description: Transaction status
        data_type: STRING
      - name: transaction_hour
        description: Hour of day when transaction occurred (0-23)
        data_type: INTEGER
      - name: transaction_day_of_week
        description: Day of week (1=Sunday, 7=Saturday)
        data_type: INTEGER
      - name: transaction_date
        description: Date of transaction
        data_type: DATE
      - name: customer_lifetime_transactions
        description: Total transactions by this customer
        data_type: INTEGER
      - name: customer_fraud_rate_pct
        description: Historical fraud rate for this customer
        data_type: NUMERIC
      - name: customer_avg_transaction_amount
        description: Customer's average transaction amount
        data_type: NUMERIC
      - name: customer_stddev_transaction_amount
        description: Customer's transaction amount standard deviation
        data_type: NUMERIC
      - name: customer_completed_transactions
        description: Number of completed transactions by customer
        data_type: INTEGER
      - name: customer_failed_transactions
        description: Number of failed transactions by customer
        data_type: INTEGER
      - name: customer_days_active
        description: Days between customer's first and last transaction
        data_type: INTEGER
      - name: amount_zscore
        description: Z-score of transaction amount vs customer average
        data_type: NUMERIC
      - name: is_max_amount_exceeded
        description: Whether transaction exceeds customer's historical max
        data_type: INTEGER
      - name: method_type
        description: Type of payment method (card, bank_account, etc.)
        data_type: STRING
      - name: payment_method_is_default
        description: Whether this is customer's default payment method
        data_type: BOOLEAN
      - name: kyc_status
        description: Customer's KYC verification status
        data_type: STRING
      - name: is_kyc_verified
        description: Whether customer is KYC verified (1=yes, 0=no)
        data_type: INTEGER
      - name: customer_risk_segment
        description: Risk segment based on fraud rate (low_risk, medium_risk, high_risk)
        data_type: STRING
        tests:
          - accepted_values:
              values: ['low_risk', 'medium_risk', 'high_risk']
      - name: created_at
        description: Transaction creation timestamp
        data_type: TIMESTAMP

  # ============================================================================
  # DIMENSION LAYER - Star Schema
  # ============================================================================

  - name: dim_customers
    description: >\n      Customer dimension table for the star schema. Contains customer attributes\n      with surrogate key (customer_key) and natural key (customer_id).\n      Output: ~34 rows
    columns:
      - name: customer_key
        description: Surrogate key (MD5 hash of customer_id)
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_id
        description: Natural key - unique customer identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_type
        description: Type of customer
        data_type: STRING
      - name: email
        description: Customer email address
        data_type: STRING
      - name: phone_number
        description: Customer phone number
        data_type: STRING
      - name: kyc_status
        description: KYC verification status
        data_type: STRING
      - name: is_active
        description: Whether the customer is active (kyc_status = VERIFIED)
        data_type: BOOLEAN
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP
      - name: dbt_loaded_at
        description: When this record was loaded by dbt
        data_type: TIMESTAMP

  - name: dim_payment_methods
    description: >\n      Payment methods dimension table. Links to dim_customers via customer_key.\n      Output: ~21 rows
    columns:
      - name: payment_method_key
        description: Surrogate key (MD5 hash of payment_method_id)
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: payment_method_id
        description: Natural key - unique payment method identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: customer_key
        description: Foreign key to dim_customers
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_customers')
              field: customer_key
      - name: method_type
        description: Type of payment method
        data_type: STRING
      - name: is_default
        description: Whether this is the customer's default payment method
        data_type: BOOLEAN
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP
      - name: dbt_loaded_at
        description: When this record was loaded by dbt
        data_type: TIMESTAMP

  - name: dim_date
    description: >\n      Date dimension table covering the entire transaction period (2025-07-26 to 2025-09-08).\n      Provides date attributes for time-based analysis.\n      Output: 44 rows
    columns:
      - name: date_key
        description: Date key in YYYYMMDD format
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: date
        description: Calendar date
        data_type: DATE
        tests:
          - not_null
      - name: year
        description: Year
        data_type: INTEGER
      - name: month
        description: Month (1-12)
        data_type: INTEGER
      - name: day
        description: Day of month (1-31)
        data_type: INTEGER
      - name: quarter
        description: Quarter (1-4)
        data_type: INTEGER
      - name: week_of_year
        description: Week of year (1-53)
        data_type: INTEGER
      - name: day_of_week
        description: Day of week (1=Sunday, 7=Saturday)
        data_type: INTEGER
      - name: is_weekend
        description: Whether the date is a weekend
        data_type: BOOLEAN
      - name: day_name
        description: Day name (Monday, Tuesday, etc.)
        data_type: STRING
      - name: month_name
        description: Month name (January, February, etc.)
        data_type: STRING
      - name: dbt_loaded_at
        description: When this record was loaded by dbt
        data_type: TIMESTAMP

  # ============================================================================
  # FACT LAYER - Star Schema
  # ============================================================================

  - name: fact_transactions
    description: >\n      Transaction fact table for the star schema. Contains transaction details\n      with foreign keys to dim_customers (debtor and creditor), dim_payment_methods,\n      and dim_date.\n      Output: ~21 rows
    columns:
      - name: transaction_key
        description: Surrogate key (MD5 hash of transaction_id)
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: transaction_id
        description: Natural key - unique transaction identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: date_key
        description: Foreign key to dim_date
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_date')
              field: date_key
      - name: debtor_customer_key
        description: Foreign key to dim_customers (payer)
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_customers')
              field: customer_key
      - name: creditor_customer_key
        description: Foreign key to dim_customers (payee)
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_customers')
              field: customer_key
      - name: payment_method_key
        description: Foreign key to dim_payment_methods
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_payment_methods')
              field: payment_method_key
      - name: transaction_amount
        description: Transaction amount
        data_type: NUMERIC
      - name: currency
        description: Currency code
        data_type: STRING
      - name: transaction_status
        description: Transaction status
        data_type: STRING
      - name: reference
        description: Transaction reference number
        data_type: STRING
      - name: created_at
        description: Record creation timestamp
        data_type: TIMESTAMP
      - name: updated_at
        description: Record last update timestamp
        data_type: TIMESTAMP
      - name: dbt_loaded_at
        description: When this record was loaded by dbt
        data_type: TIMESTAMP

  - name: fact_transaction_details
    description: >\n      Transaction details fact table. Aggregates refunds, disputes, and fees\n      by transaction. Links to fact_transactions via transaction_key.\n      Output: ~21 rows (one per transaction)
    columns:
      - name: transaction_key
        description: Foreign key to fact_transactions
        data_type: STRING
        tests:
          - not_null
          - relationships:
              to: ref('fact_transactions')
              field: transaction_key
      - name: transaction_id
        description: Transaction identifier
        data_type: STRING
      - name: refund_amount
        description: Total refund amount for this transaction
        data_type: NUMERIC
      - name: dispute_amount
        description: Total dispute amount for this transaction
        data_type: NUMERIC
      - name: fee_amount
        description: Total fee amount for this transaction
        data_type: NUMERIC
      - name: refund_count
        description: Number of refunds for this transaction
        data_type: INTEGER
      - name: dispute_count
        description: Number of disputes for this transaction
        data_type: INTEGER
      - name: fee_count
        description: Number of fees for this transaction
        data_type: INTEGER
      - name: net_transaction_amount
        description: Net amount = transaction_amount - refunds - fees
        data_type: NUMERIC
      - name: dbt_loaded_at
        description: When this record was loaded by dbt
        data_type: TIMESTAMP

  - name: fact_payouts
    description: >\n      Payout fact table for the star schema. Contains payout details\n      with foreign keys to dim_customers (recipient) and dim_date.\n      Output: ~21 rows
    columns:
      - name: payout_key
        description: Surrogate key (MD5 hash of payout_id)
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: payout_id
        description: Natural key - unique payout identifier
        data_type: STRING
        tests:
          - not_null
          - unique
      - name: date_key
        description: Foreign key to dim_date
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_date')
              field: date_key
      - name: recipient_customer_key
        description: Foreign key to dim_customers (payout recipient)
        data_type: STRING
        tests:
          - relationships:
              to: ref('dim_customers')
              field: customer_key
      - name: payout_amount
        description: Payout amount
        data_type: NUMERIC
      - name: currency
        description: Currency code
        data_type: STRING
      - name: payout_status
        description: Payout status
        data_type: STRING
